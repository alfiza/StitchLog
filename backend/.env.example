# Copy to .env and fill in. Never commit the real .env.

# PostgreSQL in production. Leave unset to use a local SQLite file for development.
DATABASE_URL=postgresql+psycopg://stitchlog:change-me@localhost:5432/stitchlog

# Long random string. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# First login, created automatically on startup if there are no users yet
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# Address of the admin/job-page site, used in the link sent to customers
PUBLIC_BASE_URL=https://app.yourdomain.ie
CORS_ORIGINS=https://app.yourdomain.ie

# Job numbers look like SL-0042
JOB_NUMBER_PREFIX=SL

# "console" = you send the ready message yourself with the WhatsApp button (free)
# "twilio_sms" or "twilio_whatsapp" = sent automatically through Twilio
NOTIFY_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
